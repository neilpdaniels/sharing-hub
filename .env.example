DJANGO_SETTINGS_MODULE=rentalution.settings.production
RENTALUTION_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=rentalution.co.uk,www.rentalution.co.uk,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://rentalution.co.uk,https://www.rentalution.co.uk
POSTGRES_DB=rentalution
POSTGRES_USER=rentalution
POSTGRES_PASSWORD=change-me-too
POSTGRES_HOST=db
POSTGRES_PORT=5432
DJANGO_STATIC_ROOT=/app/staticfiles
DJANGO_MEDIA_ROOT=/app/media
DJANGO_SECURE_SSL_REDIRECT=0
SITE_URL=https://rentalution.co.uk
# Required for iOS Universal Links and Android App Links. Use the Apple
# Developer Team ID and the SHA-256 fingerprint of the Android release signer.
MOBILE_APP_LINK_HOST=rentalution.co.uk
APPLE_APP_LINK_TEAM_ID=
ANDROID_APP_LINK_SHA256=
# Change to 1 immediately before deploying signed mobile builds. It makes the
# production environment check require both signing values above.
MOBILE_APP_LINKS_REQUIRED=0
WEB_IMAGE=ghcr.io/your-github-username-or-org/rentalution:latest
