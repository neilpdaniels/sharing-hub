DJANGO_SETTINGS_MODULE=rentalution.settings.production
RENTALUTION_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=rentalution.com,www.rentalution.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://rentalution.com,https://www.rentalution.com
POSTGRES_DB=rentalution
POSTGRES_USER=rentalution
POSTGRES_PASSWORD=change-me-too
POSTGRES_HOST=db
POSTGRES_PORT=5432
DJANGO_STATIC_ROOT=/app/staticfiles
DJANGO_MEDIA_ROOT=/app/media
DJANGO_SECURE_SSL_REDIRECT=0
WEB_IMAGE=ghcr.io/your-github-username-or-org/rentalution:latest
