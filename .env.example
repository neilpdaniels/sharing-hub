DJANGO_SETTINGS_MODULE=rentalution.settings.production
RENTALUTION_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=rentalution.co.uk,www.rentalution.co.uk,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://rentalution.co.uk,https://www.rentalution.co.uk
POSTGRES_DB=rentalution
POSTGRES_USER=rentalution
POSTGRES_PASSWORD=change-me-too
POSTGRES_HOST=db
POSTGRES_PORT=5432
FLOWER_BASIC_AUTH=operator:replace-with-a-strong-unique-password
DJANGO_STATIC_ROOT=/app/staticfiles
DJANGO_MEDIA_ROOT=/app/media
DJANGO_SECURE_SSL_REDIRECT=0
SITE_URL=https://rentalution.co.uk
TURNSTILE_SITE_KEY=0x4AAAAAAD5p_nGqBL1K_60S
# Retrieve this from the existing Cloudflare Turnstile widget and store it only
# in the deployment secret manager; never commit the value.
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=rentalution.co.uk,www.rentalution.co.uk
# Category-suggestion automation uses this existing OpenAI-compatible key for
# duplicate/policy/copy checks and the existing catalogue image generator.
OPEN_AI_API_SECRET=
CATEGORY_AI_TEXT_MODEL=gpt-4.1-mini
CATEGORY_AI_IMAGE_MODEL=gpt-image-1
# Keep disabled until the worker, budget and moderation flow are verified.
CATEGORY_AI_ENABLED=0
CATEGORY_AI_USER_WEEKLY_LIMIT=2
CATEGORY_AI_USER_MONTHLY_LIMIT=5
CATEGORY_AI_IP_DAILY_LIMIT=10
# Count of image candidates per calendar month (two candidates per approved request).
CATEGORY_AI_MONTHLY_IMAGE_LIMIT=100
# Optional: create a read-only human-review taxonomy report on the first of
# each month. The admin "Run catalogue review now" button always remains available.
CATEGORY_TAXONOMY_REVIEW_SCHEDULED_ENABLED=0
# Original listing photos up to this size are accepted, then compressed by Celery.
ORDER_IMAGE_UPLOAD_MAX_BYTES=20971520
# Long-term rentals require full-deposit capture. Keep disabled until approved.
LONG_TERM_RENTALS_ENABLED=0
# Required for iOS Universal Links and Android App Links. Use the Apple
# Developer Team ID and the SHA-256 fingerprint of the Android release signer.
MOBILE_APP_LINK_HOST=rentalution.co.uk
APPLE_APP_LINK_TEAM_ID=
ANDROID_APP_LINK_SHA256=
# Change to 1 immediately before deploying signed mobile builds. It makes the
# production environment check require both signing values above.
MOBILE_APP_LINKS_REQUIRED=0
WEB_IMAGE=ghcr.io/your-github-username-or-org/rentalution:latest
