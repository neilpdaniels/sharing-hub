#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT="/home/neil/Projects/rentalution"
MOBILE_DIR="$PROJECT_ROOT/rentalution_mobile"

if [[ -f "$PROJECT_ROOT/.venv/bin/activate" ]]; then
  # shellcheck disable=SC1091
  source "$PROJECT_ROOT/.venv/bin/activate"
fi

API_BASE_URL="${API_BASE_URL:-http://neil-laptop:8000/api/v1}"

: "${STRIPE_CONNECT_PUBLIC_KEY:=}"
APP_NAME="${APP_NAME:-Rentalution Dev}"

if [[ -z "${STRIPE_CONNECT_PUBLIC_KEY:-}" ]]; then
  echo "STRIPE_CONNECT_PUBLIC_KEY is not set in your shell or .venv/bin/activate"
  exit 1
fi

DEBUG_APK="$MOBILE_DIR/build/app/outputs/flutter-apk/app-dev-debug.apk"
declare -a build_args=()

echo ""
echo "Select a build option:"
echo "  1) Rebuild"
echo "  2) Use existing Android debug APK (skip build)"
echo "  q) Cancel"
echo ""

while true; do
  read -r -p "Build: " build_selection
  case "$build_selection" in
    1) break ;;
    2)
      if [[ ! -f "$DEBUG_APK" ]]; then
        echo "No debug APK found at $DEBUG_APK. Choose 1 to build it first."
        continue
      fi
      build_args+=("--use-application-binary=$DEBUG_APK")
      echo "Using existing APK, including its saved API URL and Stripe configuration."
      break
      ;;
    q|Q) exit 0 ;;
    *) echo "Please choose 1, 2, or q to cancel." ;;
  esac
done

declare -a device_ids=()
declare -a device_labels=()

if command -v adb >/dev/null 2>&1; then
  # adb separates the serial and state with a tab; wireless serials can contain spaces.
  while IFS=$'\t' read -r device_id device_state; do
    [[ "$device_state" == "device" ]] || continue

    if [[ "$device_id" == adb-* || "$device_id" == *:* ]]; then
      device_ids+=("$device_id")
      device_labels+=("Android wireless ($device_id)")
    else
      device_ids+=("$device_id")
      device_labels+=("Android USB ($device_id)")
    fi
  done < <(adb devices | tail -n +2)
fi

if [[ "$build_selection" == "1" ]]; then
  device_ids+=("linux")
  device_labels+=("Linux desktop")
fi

if ((${#device_ids[@]} == 0)); then
  echo "No connected Android devices available. Connect a device and try again."
  exit 1
fi

echo ""
echo "Select a device:"
for index in "${!device_ids[@]}"; do
  printf '  %d) %s\n' "$((index + 1))" "${device_labels[$index]}"
done
echo "  q) Cancel"
echo ""

while true; do
  read -r -p "Device: " selection
  if [[ "$selection" == "q" || "$selection" == "Q" ]]; then
    exit 0
  fi

  if [[ "$selection" =~ ^[0-9]+$ ]] && ((selection >= 1 && selection <= ${#device_ids[@]})); then
    selected_device="${device_ids[$((selection - 1))]}"
    break
  fi

  echo "Please choose one of the listed numbers, or q to cancel."
done

# Flutter splits ADB serials on spaces. Connect by endpoint for mDNS names
# containing spaces so Flutter can address the same phone correctly.
if [[ "$selected_device" == adb-* && "$selected_device" == *" "* ]]; then
  service_name="${selected_device%._adb-tls-connect._tcp}"
  wireless_endpoint="$(adb mdns services 2>/dev/null | awk -v name="$service_name" '
    {
      sub(/^[[:space:]]+/, "")
      if (index($0, name) != 1) next
      rest = substr($0, length(name) + 1)
      if (rest !~ /^[[:space:]]+_adb-tls-connect\._tcp[[:space:]]+/) next
      sub(/^[[:space:]]+_adb-tls-connect\._tcp[[:space:]]+/, "", rest)
      split(rest, fields, /[[:space:]]+/)
      print fields[1]
      exit
    }
  ' || true)"

  if [[ -z "$wireless_endpoint" ]]; then
    echo "Could not discover this phone's wireless address."
    echo "On the phone, open Developer options > Wireless debugging > IP address & port."
    read -r -p "Enter IP:port (not the pairing port), or q to cancel: " wireless_endpoint
    [[ "$wireless_endpoint" == "q" || "$wireless_endpoint" == "Q" ]] && exit 0
  fi

  if [[ ! "$wireless_endpoint" =~ ^[^[:space:]]+:[0-9]+$ ]]; then
    echo "Invalid wireless address. Expected IP:port."
    exit 1
  fi

  echo "Connecting to $wireless_endpoint for Flutter..."
  adb connect "$wireless_endpoint"
  if [[ "$(adb -s "$wireless_endpoint" get-state 2>/dev/null)" != "device" ]]; then
    echo "Could not connect to the phone. Check Wireless debugging and try again."
    exit 1
  fi
  selected_device="$wireless_endpoint"
fi

if [[ "$build_selection" == "1" ]]; then
  echo "Using API_BASE_URL=$API_BASE_URL"
fi
echo "Using device: ${device_labels[$((selection - 1))]}"

cd "$MOBILE_DIR"
flutter run \
  -d "$selected_device" \
  --flavor dev \
  --dart-define=APP_NAME="$APP_NAME" \
  --dart-define=API_BASE_URL="$API_BASE_URL" \
  --dart-define=STRIPE_PUBLISHABLE_KEY="$STRIPE_CONNECT_PUBLIC_KEY" \
  "${build_args[@]}" \
  "$@"
