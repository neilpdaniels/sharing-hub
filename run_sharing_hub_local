#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT="/home/neil/Projects/sharing-hub"
VENV_PATH="$PROJECT_ROOT/.venv/bin/activate"
SETTINGS_MODULE="sharing_hub.settings.local"
DJANGO_APP="sharing_hub"
LOG_DIR="$PROJECT_ROOT/logs"
RUNSERVER_LOG="$LOG_DIR/runserver.log"
CELERY_WORKER_LOG="$LOG_DIR/celery_worker.log"
CELERY_BEAT_LOG="$LOG_DIR/celery_beat.log"
FLOWER_LOG="$LOG_DIR/flower.log"

pkill -f "celery -A $DJANGO_APP worker" || true
pkill -f "celery -A $DJANGO_APP beat" || true
pkill -f "celery -A $DJANGO_APP flower" || true
pkill -f "manage.py runserver" || true

source "$VENV_PATH"
cd "$PROJECT_ROOT"
mkdir -p "$LOG_DIR"

export DJANGO_SETTINGS_MODULE="$SETTINGS_MODULE"

DEFAULT_FCM_SERVICE_ACCOUNT_FILE="$HOME/.secrets/mobberley-labs-sharing-hub-firebase-adminsdk-fbsvc-e668797b17.json"
if [[ -f "$DEFAULT_FCM_SERVICE_ACCOUNT_FILE" ]]; then
    if [[ -z "${FCM_SERVICE_ACCOUNT_FILE:-}" || ! -f "$FCM_SERVICE_ACCOUNT_FILE" ]]; then
        export FCM_SERVICE_ACCOUNT_FILE="$DEFAULT_FCM_SERVICE_ACCOUNT_FILE"
    fi
fi

ALWAYS_EAGER="$(uv run python - <<'PY'
from django.conf import settings
print(int(bool(getattr(settings, 'CELERY_TASK_ALWAYS_EAGER', False))))
PY
)"

if [[ "$ALWAYS_EAGER" == "1" ]]; then
    echo "CELERY_TASK_ALWAYS_EAGER=True -> skipping Celery worker, beat, and Flower"
else
    nohup uv run celery -A "$DJANGO_APP" worker -l info -f "$CELERY_WORKER_LOG" > /dev/null 2>&1 &
    echo "Started Celery worker (log: $CELERY_WORKER_LOG)"

    nohup uv run celery -A "$DJANGO_APP" beat -l info -f "$CELERY_BEAT_LOG" > /dev/null 2>&1 &
    echo "Started Celery beat (log: $CELERY_BEAT_LOG)"

    nohup uv run celery -A "$DJANGO_APP" flower > "$FLOWER_LOG" 2>&1 &
    echo "Started Flower (log: $FLOWER_LOG)"
fi

echo "Starting Django runserver (live output + log: $RUNSERVER_LOG)"
PYTHONUNBUFFERED=1 uv run python manage.py runserver localhost:8000 --settings="$SETTINGS_MODULE" 2>&1 | tee -a "$RUNSERVER_LOG"
